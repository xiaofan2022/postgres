CREATE TABLE tb_types(
id int primary key,
c_bigbit bigint,
c_bigserial bigserial,
c_bit10 bit(10),
c_varbit10 varbit(10),
c_bool bool,
c_box box,
c_bytea bytea,
c_char char,
c_char10 char(10),
c_varchar10 varchar(10),
c_cidr cidr,
c_circle circle,
c_date date,
c_float8 float8,
c_inet inet,
c_int int,
c_interval interval,
c_json json,
c_jsonb jsonb,
c_line line,
c_lseg lseg,
c_macaddr macaddr,
c_macaddr8 macaddr8,
c_money money,
c_numeric10_3 numeric(10,3),
c_path path,
c_pg_lsn pg_lsn,
c_point point,
c_polygon polygon,
c_float4 float4,
c_smallint smallint,
c_smallserial smallserial,
c_serial serial,
c_text text,
c_time  time,
c_timetz timetz,
c_timestamp timestamp,
c_timestamptz timestamptz,
c_tsquery tsquery,
c_tsvector tsvector,
c_txid_snapshot txid_snapshot,
c_uuid uuid,
c_inta int[]
);
