ALTER TABLE t2 DROP COLUMN k; 
ALTER TABLE t2 ALTER COLUMN m TYPE int8;
ALTER TABLE t2 RENAME COLUMN m to n;
ALTER TABLE t2 RENAME TO t2_1;
DROP TABLE t1;
